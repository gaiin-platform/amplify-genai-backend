{
  "services": [
    "amplify-lambda",
    "amplify-assistants",
    "amplify-lambda-admin",
    "amplify-lambda-api",
    "amplify-lambda-artifacts",
    "amplify-lambda-js",
    "amplify-lambda-ops",
    "chat-billing",
    "data-disclosure",
    "embedding",
    "object-access",
    "amplify-lambda-assistants-api",
    "amplify-lambda-assistants-api-google",
    "amplify-lambda-assistants-api-office365",
    "amplify-agent-loop-lambda"
